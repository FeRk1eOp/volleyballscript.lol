-- Табы
local tabs = {}
local function addTab(name, title)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1,0,0,40)
    btn.Text = title
    btn.BackgroundColor3 = COLORS.Button
    btn.TextColor3 = COLORS.TextDark
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.Parent = btnContainer
    local corner = Instance.new("UICorner") corner.CornerRadius = UDim.new(0,8) corner.Parent = btn

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1,0,1,0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 6
    page.CanvasSize = UDim2.new(0,0,0,0) -- автоматически расширяется
    page.Visible = false
    page.Parent = content

    btn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.btn.BackgroundColor3 = COLORS.Button
            t.btn.TextColor3 = COLORS.TextDark
            t.page.Visible = false
        end
        btn.BackgroundColor3 = COLORS.ButtonSelected
        btn.TextColor3 = COLORS.Text
        page.Visible = true
    end)

    tabs[name] = {btn = btn, page = page}
    return page
end

