        local targetCol = active and Color3.fromRGB(50,200,50) or COLORS.Button
        local targetPos = active and posOn or posOff
        TweenService:Create(sw, TweenInfo.new(0.15), {BackgroundColor3 = targetCol}):Play()
        TweenService:Create(handle, TweenInfo.new(0.15), {Position = targetPos}):Play()
    end

    local function setValue(v)
        if active == v then return end
        active = v
        updateVis()
        if active then pcall(onFunc) else pcall(offFunc) end
    end
    sw.MouseButton1Click:Connect(function() setValue(not active) end)
    if defaultVal then updateVis() end
    toggleRegistry[name] = setValue
    return container
end

-- Stepper control (кнопки +-)
local function CreateStepper(parent, labelText, minVal, maxVal, step, defaultValue, onChange)
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1,0,0,buttonHeight)
    container.BackgroundTransparency = 1
    container.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0.5,0,1,0)
    label.Position = UDim2.new(0,6,0,0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = COLORS.Text
    label.Font = Enum.Font.Gotham
    label.TextSize = fontSize-1
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = container

    local minus = Instance.new("TextButton")
    minus.Size = UDim2.new(0,36,0,32)
    minus.Position = UDim2.new(0.65,0,0.5,-16)
    minus.Text = "-"
    minus.BackgroundColor3 = COLORS.Button
    minus.TextColor3 = COLORS.Text
    minus.Font = Enum.Font.GothamBold
    minus.TextSize = 18
    minus.Parent = container
    local mCorner = Instance.new("UICorner") mCorner.CornerRadius = UDim.new(0,6) mCorner.Parent = minus

    local valLabel = Instance.new("TextLabel")
    valLabel.Size = UDim2.new(0,55,0,32)
    valLabel.Position = UDim2.new(0.78,0,0.5,-16)
    valLabel.BackgroundColor3 = COLORS.Button
    valLabel.Text = tostring(defaultValue)
    valLabel.TextColor3 = COLORS.Text
    valLabel.Font = Enum.Font.Gotham
    valLabel.TextSize = fontSize
    valLabel.Parent = container
    local vCorner = Instance.new("UICorner") vCorner.CornerRadius = UDim.new(0,6) vCorner.Parent = valLabel

    local plus = Instance.new("TextButton")
    plus.Size = UDim2.new(0,36,0,32)
    plus.Position = UDim2.new(0.91,0,0.5,-16)
    plus.Text = "+"
    plus.BackgroundColor3 = COLORS.Button
    plus.TextColor3 = COLORS.Text
    plus.Font = Enum.Font.GothamBold
    plus.TextSize = 18
    plus.Parent = container
    local pCorner = Instance.new("UICorner") pCorner.CornerRadius = UDim.new(0,6) pCorner.Parent = plus

    local current = math.clamp(defaultValue, minVal, maxVal)
    local function updateUI()
        if step >= 1 then valLabel.Text = string.format("%d", current)
        else valLabel.Text = string.format("%.1f", current) end
    end
    local function setValue(newVal)
        newVal = math.clamp(newVal, minVal, maxVal)
        if math.abs(newVal - current) > 0.001 then
            current = newVal
            updateUI()
            if onChange then onChange(current) end
        end
    end
    minus.MouseButton1Click:Connect(function() setValue(current - step) end)
    plus.MouseButton1Click:Connect(function() setValue(current + step) end)
    updateUI()
    return { setValue = setValue, getValue = function() return current end }
end

