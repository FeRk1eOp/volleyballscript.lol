local function antiFall(ch)
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    if not hrp or hrp.Position.Y > 1.5 then return end
    local ray = Ray.new(hrp.Position + Vector3.new(0,0.5,0), Vector3.new(0,-2,0))
    local hit, pos = workspace:FindPartOnRay(ray, ch)
    if hit and pos then
        local newY = pos.Y + 2.2
        if hrp.Position.Y < newY - 0.3 then hrp.CFrame = CFrame.new(hrp.Position.X, newY, hrp.Position.Z) end
    end
end
task.spawn(function()
    while true do
        if ScriptSettings.AirControlEnabled then
            local ch = LocalPlayer.Character
            if ch then
                local hrp = ch:FindFirstChild("HumanoidRootPart"); local hum = ch:FindFirstChild("Humanoid")
                if hrp and hum then
                    local state = hum:GetState()
                    local inAir = (state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall)
                    if inAir then
                        local move = Vector3.new(0,0,0)
                        if airKeys.W then move = move + Vector3.new(0,0,-1) end
                        if airKeys.S then move = move + Vector3.new(0,0,1) end
                        if airKeys.A then move = move + Vector3.new(-1,0,0) end
                        if airKeys.D then move = move + Vector3.new(1,0,0) end
                        if move.Magnitude > 0 then
                            move = move.Unit
                            local cf = Camera.CFrame
                            local world = (cf.LookVector * -move.Z + cf.RightVector * move.X) * Vector3.new(1,0,1)
                            if world.Magnitude > 0 then world = world.Unit * ScriptSettings.AirControlSpeed end
                            hrp.Velocity = Vector3.new(world.X, hrp.Velocity.Y, world.Z)
                        else
                            hrp.Velocity = Vector3.new(hrp.Velocity.X * 0.96, hrp.Velocity.Y, hrp.Velocity.Z * 0.96)
                        end
                        antiFall(ch)
                    end
                end
            end
        end
        task.wait()
    end
end)

