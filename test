local airKeys = {W=false, A=false, S=false, D=false}
local function handleAirInput(_, state, input)
    local key = input.KeyCode; local b = (state == Enum.UserInputState.Begin)
    if key == Enum.KeyCode.W then airKeys.W = b
    elseif key == Enum.KeyCode.A then airKeys.A = b
    elseif key == Enum.KeyCode.S then airKeys.S = b
    elseif key == Enum.KeyCode.D then airKeys.D = b end
    return Enum.ContextActionResult.Pass
end
ContextActionService:BindAction("AirW", handleAirInput, false, Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D)
local function fixAutoRotate(ch)
    local hum = ch:WaitForChild("Humanoid"); hum.AutoRotate = true
    hum:GetPropertyChangedSignal("AutoRotate"):Connect(function() if not hum.AutoRotate then hum.AutoRotate = true end end)
end
