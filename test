local function ClearPlayerESP(p)
    if p and p.Character then
        local h = p.Character:FindFirstChild("ESPHighlight")
        if h then h:Destroy() end
        local head = p.Character:FindFirstChild("Head")
        if head then
            local b = head:FindFirstChild("HPBillboard")
            if b then b:Destroy() end
        end
    end
end

local function UpdateESP()
    for _, p in pairs(Players:GetPlayers()) do
        if p and p ~= LocalPlayer and p.Character then
            local char = p.Character
            local root = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChild("Humanoid")
            if root then
                local hl = char:FindFirstChild("ESPHighlight")
                if ESP_Settings.ESPEnabled then
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = "ESPHighlight"
                        hl.FillTransparency = 0.5
                        hl.OutlineTransparency = 0
                        hl.Parent = char
                    end
                    local col = ESP_Settings.TeamBlueColor
                    if p.Team and LocalPlayer.Team then
                        col = (p.Team == LocalPlayer.Team) and ESP_Settings.TeamBlueColor or (p.TeamColor and p.TeamColor.Color or Color3.fromRGB(255,0,0))
                    else
                        col = p.TeamColor and p.TeamColor.Color or Color3.fromRGB(255,0,0)
                    end
                    if hl.FillColor ~= col then hl.FillColor = col end
                    if hl.OutlineColor ~= col then hl.OutlineColor = col end
                else
                    if hl then hl:Destroy() end
                end
                local head = char:FindFirstChild("Head")
                if ESP_Settings.HPEnabled and head and hum then
                    local bill = head:FindFirstChild("HPBillboard")
                    if not bill then
                        bill = Instance.new("BillboardGui")
                        bill.Name = "HPBillboard"
                        bill.Adornee = head
                        bill.Size = UDim2.new(0,100,0,50)
                        bill.StudsOffset = Vector3.new(0,2,0)
                        bill.AlwaysOnTop = true
                        local txt = Instance.new("TextLabel")
                        txt.Name = "TextLabel"
                        txt.Size = UDim2.new(1,0,1,0)
                        txt.BackgroundTransparency = 1
                        txt.TextStrokeTransparency = 0.7
                        txt.Font = Enum.Font.GothamBold
                        txt.TextSize = 14
                        txt.TextXAlignment = Enum.TextXAlignment.Center
                        txt.TextYAlignment = Enum.TextYAlignment.Center
                        txt.Parent = bill
                        bill.Parent = head
                    end
                    local hpText = bill:FindFirstChild("TextLabel")
                    if hpText then
                        hpText.Text = p.Name .. " (" .. math.floor(hum.Health) .. " HP)"
                        local frac = hum.Health / hum.MaxHealth
                        hpText.TextColor3 = Color3.new(1, frac, frac)
                    end
                else
                    local bill = head and head:FindFirstChild("HPBillboard")
                    if bill then bill:Destroy() end
                end
            else
                ClearPlayerESP(p)
            end
        else
            ClearPlayerESP(p)
        end
    end
end

RunService.RenderStepped:Connect(function() pcall(UpdateESP) end)
Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function() task.wait(0.5) pcall(UpdateESP) end)
