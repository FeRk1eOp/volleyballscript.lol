-- 🔥 ИСПРАВЛЕННАЯ ФУНКЦИЯ ЗАГРУЗКИ КОНФИГА
local function loadConfig(name)
    local data = loadCfg(name)
    if not data then return false end
    
    ScriptSettings.ESPEnabled = data.ESPEnabled
    ScriptSettings.HPEnabled = data.HPEnabled
    ScriptSettings.HitboxEnabled = data.HitboxEnabled
    ScriptSettings.HitboxExtraSize = data.HitboxExtraSize or 0
    ScriptSettings.HitboxShowSphere = data.HitboxShowSphere
    ScriptSettings.HitboxColor = Color3.fromRGB(data.HitboxColorR or 255, data.HitboxColorG or 0, data.HitboxColorB or 0)
    ScriptSettings.HitboxTransparency = data.HitboxTransparency or 0.7
    ScriptSettings.AirControlEnabled = data.AirControlEnabled
    ScriptSettings.AirControlSpeed = data.AirControlSpeed or 30
    ScriptSettings.AutoSpinEnabled = data.AutoSpinEnabled
    ScriptSettings.AutoSpinType = data.AutoSpinType
    ScriptSettings.AutoSpinSlot = data.AutoSpinSlot or 1
    ScriptSettings.AutoAbilityEnabled = data.AutoAbilityEnabled
    ScriptSettings.AutoAbilityType = data.AutoAbilityType
    ScriptSettings.AutoAbilitySlot = data.AutoAbilitySlot or 1
    ScriptSettings.TracerEnabled = data.TracerEnabled
    ScriptSettings.TracerColor = Color3.fromRGB(data.TracerColorR or 255, data.TracerColorG or 100, data.TracerColorB or 0)
    ScriptSettings.TracerLength = data.TracerLength or 15
    ScriptSettings.TracerThickness = data.TracerThickness or 0.3
    ScriptSettings.LegitLockEnabled = data.LegitLockEnabled
    if data.LegitLockKeyCode then
        ScriptSettings.LegitLockKey = Enum.KeyCode[data.LegitLockKeyCode] or Enum.KeyCode.L
    end

    -- Обновление переключателей
    if toggleRegistry["Enable Wallhack / ESP"] then toggleRegistry["Enable Wallhack / ESP"](ScriptSettings.ESPEnabled) end
    if toggleRegistry["Show Health (HP)"] then toggleRegistry["Show Health (HP)"](ScriptSettings.HPEnabled) end
    if toggleRegistry["Enable Hitbox Modification"] then toggleRegistry["Enable Hitbox Modification"](ScriptSettings.HitboxEnabled) end
    if toggleRegistry["Show Sphere"] then toggleRegistry["Show Sphere"](ScriptSettings.HitboxShowSphere) end
    if toggleRegistry["Move in Air (WASD)"] then toggleRegistry["Move in Air (WASD)"](ScriptSettings.AirControlEnabled) end
    if toggleRegistry["AutoSpin Style"] then toggleRegistry["AutoSpin Style"](ScriptSettings.AutoSpinEnabled) end
    if toggleRegistry["AutoSpin Ability"] then toggleRegistry["AutoSpin Ability"](ScriptSettings.AutoAbilityEnabled) end
    if toggleRegistry["Enable Tracer"] then toggleRegistry["Enable Tracer"](ScriptSettings.TracerEnabled) end
    if toggleRegistry["Legit Lock (Jump turn)"] then toggleRegistry["Legit Lock (Jump turn)"](ScriptSettings.LegitLockEnabled) end

    -- Обновление слайдеров
    if radiusStepper and radiusStepper.setValue then radiusStepper.setValue(ScriptSettings.HitboxExtraSize) end
    if alphaStepper and alphaStepper.setValue then alphaStepper.setValue(ScriptSettings.HitboxTransparency) end
    if airSpeedStepper and airSpeedStepper.setValue then airSpeedStepper.setValue(ScriptSettings.AirControlSpeed) end
    if lengthStepper and lengthStepper.setValue then lengthStepper.setValue(ScriptSettings.TracerLength) end
    if thickStepper and thickStepper.setValue then thickStepper.setValue(ScriptSettings.TracerThickness) end

    -- Обновление текста кнопок цветов
    for i, col in ipairs(sphereColors) do
        if col[1] == ScriptSettings.HitboxColor then
            sphereColorIdx = i
            if colorBtn then colorBtn.Text = "Color: " .. col[2] end
            break
        end
    end
    for i, col in ipairs(tracerColors) do
        if col[1] == ScriptSettings.TracerColor then
            tracerColorIdx = i
            if tracerColorBtn then tracerColorBtn.Text = "Color: " .. col[2] end
            break
        end
    end

    -- Обновление текста типа спина
    if styleTypeLabel then styleTypeLabel.Text = "Spin type: " .. (ScriptSettings.AutoSpinType and "Lucky" or "Regular") end
    if abilityTypeLabel then abilityTypeLabel.Text = "Spin type: " .. (ScriptSettings.AutoAbilityType and "Lucky" or "Regular") end

    -- Обновление слотов (визуал)
    updateStyleSlotLabel()
    updateAbilitySlotLabel()
    
    if styleSlotContainer then
        for _, btn in ipairs(styleSlotContainer:GetChildren()) do
            if btn:IsA("TextButton") then
                local num = tonumber(btn.Text)
                btn.BackgroundColor3 = (num == ScriptSettings.AutoSpinSlot) and COLORS.ButtonSelected or COLORS.Button
            end
        end
    end
    if abilitySlotContainer then
        for _, btn in ipairs(abilitySlotContainer:GetChildren()) do
            if btn:IsA("TextButton") then
                local num = tonumber(btn.Text)
                btn.BackgroundColor3 = (num == ScriptSettings.AutoAbilitySlot) and COLORS.ButtonSelected or COLORS.Button
            end
        end
    end

    -- Обновление ключа легит лока
    if legitKeyLabel then
        legitKeyLabel.Text = "Toggle key: " .. tostring(ScriptSettings.LegitLockKey):gsub("Enum.KeyCode.", "")
    end
    ContextActionService:UnbindAction("LegitLockToggle")
    ContextActionService:BindAction("LegitLockToggle", function(_, state, _)
        if state == Enum.UserInputState.Begin then toggleLegitLock() end
    end, false, ScriptSettings.LegitLockKey)

    -- Применение настроек
    ESP_Settings.ESPEnabled = ScriptSettings.ESPEnabled
    ESP_Settings.HPEnabled = ScriptSettings.HPEnabled
    UpdateESP()
    updateHitboxSphere()
    
    return true
end

