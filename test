-- ========== TRACER (плавный) ==========
local tracers = {}
local function updateTracers()
    if not ScriptSettings.TracerEnabled then
        for _, line in pairs(tracers) do if line then line:Destroy() end end
        tracers = {}
        return
    end
    for _, p in pairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local char = p.Character
        if not char then
            if tracers[p] then tracers[p]:Destroy() tracers[p] = nil end
            continue
        end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local dir = hrp.CFrame.LookVector; dir = Vector3.new(dir.X, 0, dir.Z).Unit
        local startPos = hrp.Position
        local length = ScriptSettings.TracerLength
        local endPos = startPos + dir * length; endPos = Vector3.new(endPos.X, startPos.Y, endPos.Z)
        local distance = (endPos - startPos).Magnitude
        if not tracers[p] then
            local line = Instance.new("Part")
            line.Anchored = true; line.CanCollide = false; line.Material = Enum.Material.Neon
            line.Size = Vector3.new(ScriptSettings.TracerThickness, ScriptSettings.TracerThickness, distance)
            local mesh = Instance.new("BlockMesh"); mesh.Parent = line
            line.Parent = workspace
            tracers[p] = line
        end
        local line = tracers[p]
        if distance < 0.5 then line.Transparency = 1 continue end
        line.Transparency = 0; line.Color = ScriptSettings.TracerColor
        line.Size = Vector3.new(ScriptSettings.TracerThickness, ScriptSettings.TracerThickness, distance)
        local mid = (startPos + endPos) / 2
        line.CFrame = CFrame.lookAt(mid, endPos)
    end
    for p, line in pairs(tracers) do
        if not p or not p.Character then line:Destroy(); tracers[p] = nil end
    end
end
RunService.RenderStepped:Connect(updateTracers)

-- ========== ХИТБОКС ==========
local hitboxSphere, hitboxWeld, currentBall, basePartSize = nil, nil, nil, nil
local function findBall()
    for _, child in ipairs(workspace:GetChildren()) do
        if string.match(child.Name, "^CLIENT_BALL_") then return child end
    end
    return nil
end
local function findBasePart(ball)
    if not ball then return nil end
    for _, child in ipairs(ball:GetChildren()) do
        if child:IsA("BasePart") and child.Name ~= "SphereHitbox" then return child end
    end
    return nil
end
local function createSphere(centerPart, radius)
    if hitboxSphere then hitboxSphere:Destroy() end
    if hitboxWeld then hitboxWeld:Destroy() end
    local s = Instance.new("Part")
    s.Name = "SphereHitbox"; s.Shape = Enum.PartType.Ball
    s.Size = Vector3.new(radius*2, radius*2, radius*2)
    s.CFrame = centerPart.CFrame; s.Anchored = false; s.CanCollide = false
    s.Material = Enum.Material.ForceField; s.Color = ScriptSettings.HitboxColor
    s.Transparency = ScriptSettings.HitboxShowSphere and ScriptSettings.HitboxTransparency or 1
    s.Parent = centerPart.Parent
    hitboxWeld = Instance.new("WeldConstraint"); hitboxWeld.Part0 = centerPart; hitboxWeld.Part1 = s; hitboxWeld.Parent = s
    return s
end
local function updateHitboxSphere()
    if not hitboxSphere or not basePartSize then return end
    local baseRadius = (basePartSize.X + basePartSize.Y + basePartSize.Z) / 6
    local targetRadius = baseRadius + (ScriptSettings.HitboxEnabled and ScriptSettings.HitboxExtraSize or 0)
    local newSize = targetRadius * 2
    hitboxSphere.Size = Vector3.new(newSize, newSize, newSize)
    hitboxSphere.Color = ScriptSettings.HitboxColor
    hitboxSphere.Transparency = ScriptSettings.HitboxShowSphere and ScriptSettings.HitboxTransparency or 1
end
task.spawn(function()
    while true do
        pcall(function()
            local ball = findBall()
            if ball then
                local part = findBasePart(ball)
                if part then
                    if ball ~= currentBall then
                        currentBall = ball; basePartSize = part.Size
                        local baseRadius = (basePartSize.X + basePartSize.Y + basePartSize.Z) / 6
                        hitboxSphere = createSphere(part, baseRadius)
                    end
                    if hitboxSphere then updateHitboxSphere() end
                else
                    if hitboxSphere then hitboxSphere:Destroy() end
                    if hitboxWeld then hitboxWeld:Destroy() end
                    hitboxSphere = nil
                end
            else
                if hitboxSphere then hitboxSphere:Destroy() end
                if hitboxWeld then hitboxWeld:Destroy() end
                hitboxSphere, currentBall, basePartSize = nil, nil, nil
            end
        end)
        task.wait(0.1)
    end
end)

