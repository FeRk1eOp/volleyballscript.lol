local function antiFall(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if hrp.Position.Y > 1.5 then return end
    local ray = Ray.new(hrp.Position + Vector3.new(0, 0.5, 0), Vector3.new(0, -2, 0))
    local hit, pos = workspace:FindPartOnRay(ray, character)
    if hit and pos then
        local newY = pos.Y + 2.2
        if hrp.Position.Y < newY - 0.3 then
            hrp.CFrame = CFrame.new(hrp.Position.X, newY, hrp.Position.Z)
        end
    end
end

task.spawn(function()
    while true do
        if ScriptSettings.AirControlEnabled then
            local char = LocalPlayer.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChild("Humanoid")
                if hrp and hum then
                    local state = hum:GetState()
                    local isInAir = (state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall)
                    if isInAir then
                        local moveDir = Vector3.new(0,0,0)
                        if airKeys.W then moveDir = moveDir + Vector3.new(0,0,-1) end
                        if airKeys.S then moveDir = moveDir + Vector3.new(0,0,1) end
                        if airKeys.A then moveDir = moveDir + Vector3.new(-1,0,0) end
                        if airKeys.D then moveDir = moveDir + Vector3.new(1,0,0) end
                        if moveDir.Magnitude > 0 then
                            moveDir = moveDir.Unit
                            local camF = Camera.CFrame.LookVector
                            local camR = Camera.CFrame.RightVector
                            local worldMove = (camF * -moveDir.Z + camR * moveDir.X) * Vector3.new(1,0,1)
                            if worldMove.Magnitude > 0 then
                                worldMove = worldMove.Unit * ScriptSettings.AirControlSpeed
                            end
                            hrp.Velocity = Vector3.new(worldMove.X, hrp.Velocity.Y, worldMove.Z)
                        else
                            hrp.Velocity = Vector3.new(hrp.Velocity.X * 0.96, hrp.Velocity.Y, hrp.Velocity.Z * 0.96)
                        end
                        antiFall(char)
                    end
                end
            end
        end
        task.wait()
    end
end)

