-- ======================== LEGIT LOCK ========================
local legitLockCooldown = false

local function toggleLegitLock()
    ScriptSettings.LegitLockEnabled = not ScriptSettings.LegitLockEnabled
    notify("Legit Lock " .. (ScriptSettings.LegitLockEnabled and "ON" or "OFF"), false)
end

local function setupLegitLock(character)
    if not character then return end
    local hum = character:WaitForChild("Humanoid", 5)
    local root = character:WaitForChild("HumanoidRootPart", 5)
    if not hum or not root then return end

    local connection
    connection = hum.StateChanged:Connect(function(_, newState)
        if not ScriptSettings.LegitLockEnabled then return end
        if newState ~= Enum.HumanoidStateType.Jumping then return end
        if legitLockCooldown then return end
        legitLockCooldown = true

        task.delay(0.01 + math.random() * 0.015, function()
            if not (hum and hum.Parent and root and root.Parent) then return end
            local camLook = Camera.CFrame.LookVector
            local look = Vector3.new(camLook.X, 0, camLook.Z)
            if look.Magnitude < 0.1 then return end
            look = look.Unit
            local currentPos = root.Position
            local targetCFrame = CFrame.lookAt(currentPos, currentPos + look)
            root.CFrame = CFrame.new(currentPos) * (targetCFrame.Rotation)
            hum.AutoRotate = false
            task.delay(0.22 + math.random() * 0.08, function()
                if hum and hum.Parent then hum.AutoRotate = true end
                legitLockCooldown = false
            end)
        end)
    end)
end

if LocalPlayer.Character then setupLegitLock(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(setupLegitLock)

ContextActionService:BindAction("LegitLockToggle", function(_, state, _)
    if state == Enum.UserInputState.Begin then toggleLegitLock() end
end, false, ScriptSettings.LegitLockKey)

