-- ======================== AUTOFARM (coins) ========================
local mapNamesFarm = {"ResearchFacility","Mansion2","Hotel","Hospital3","House2","Bank2"}
local farmThread = nil

local function getHrp()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function findNearestCoin()
    local hrp = getHrp()
    if not hrp then return nil end
    local bestCoin, bestDist = nil, math.huge
    for _, mapName in ipairs(mapNamesFarm) do
        local map = workspace:FindFirstChild(mapName)
        if map then
            local coinContainer = map:FindFirstChild("CoinContainer")
            if coinContainer then
                for _, coin in ipairs(coinContainer:GetChildren()) do
                    if coin:IsA("BasePart") and (string.find(coin.Name, "Coin") or string.find(coin.Name, "Server")) then
                        local dist = (coin.Position - hrp.Position).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            bestCoin = coin
                        end
                    end
                end
            end
        end
    end
    return bestCoin
end

local function teleportToCoin()
    local coin = findNearestCoin()
    if not coin then return end
    local hrp = getHrp()
    if hrp then
        hrp.CFrame = CFrame.new(coin.Position + Vector3.new(0, 2, 0))
    end
end

local function startFarm()
    if farmThread then return end
    farmThread = task.spawn(function()
        while ScriptSettings.AutoFarmEnabled do
            teleportToCoin()
            task.wait(ScriptSettings.FarmDelay)
        end
        farmThread = nil
    end)
end

local function stopFarm()
    if farmThread then
        task.cancel(farmThread)
        farmThread = nil
    end
end

local function onFarmToggle()
    if ScriptSettings.AutoFarmEnabled then startFarm() else stopFarm() end
end

-- ======================== GUN DROP TP ========================
local mapNamesGun = {"ResearchFacility","Mansion2","Hotel","Hospital3","House2","Bank2", "MilBase", "Factory", "Workplace", "BioLab", "Office3", "PoliceStation"}
local gunDropThread = nil

local function findGunDrop()
    for _, mapName in ipairs(mapNamesGun) do
        local map = workspace:FindFirstChild(mapName)
        if map then
            local gunDrop = map:FindFirstChild("GunDrop")
            if gunDrop and gunDrop:IsA("BasePart") then
                return gunDrop
            end
        end
    end
    return nil
end

local function teleportToGunDrop()
    local gunDrop = findGunDrop()
    if not gunDrop then return false end
    local hrp = getHrp()
    if hrp then
        hrp.CFrame = CFrame.new(gunDrop.Position + Vector3.new(0, 3, 0))
        return true
    end
    return false
end

local function startAutoGunDrop()
    if gunDropThread then return end
    gunDropThread = task.spawn(function()
        while ScriptSettings.AutoGunDropEnabled do
            teleportToGunDrop()
            task.wait(ScriptSettings.GunDropDelay)
        end
        gunDropThread = nil
    end)
end

local function stopAutoGunDrop()
    if gunDropThread then
        task.cancel(gunDropThread)
        gunDropThread = nil
    end
end

local function onGunDropToggle()
    if ScriptSettings.AutoGunDropEnabled then
        startAutoGunDrop()
    else
        stopAutoGunDrop()
    end
end

