-- PLAYER FUNCTIONS (JumpPower / Speed / Fly / NoClip)
-- =====================================================================
local flying     = false
local flyBodyVel = nil
local flyKeys    = {W=false, A=false, S=false, D=false, Space=false, Ctrl=false}

local function setJumpPower()
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum.JumpPower = ScriptSettings.JumpPowerEnabled and ScriptSettings.JumpPowerValue or 50
        end
    end
end

local function setSpeed()
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChild("Humanoid")
        if hum then
            hum.WalkSpeed = ScriptSettings.SpeedEnabled and ScriptSettings.SpeedValue or 16
        end
    end
end

local function stopFly()
    if flyBodyVel then flyBodyVel:Destroy() end
    flyBodyVel = nil
    flying     = false
    pcall(ContextActionService.UnbindAction, ContextActionService, "FlyW")
    pcall(ContextActionService.UnbindAction, ContextActionService, "FlyA")
    pcall(ContextActionService.UnbindAction, ContextActionService, "FlyS")
    pcall(ContextActionService.UnbindAction, ContextActionService, "FlyD")
    pcall(ContextActionService.UnbindAction, ContextActionService, "FlySpace")
    pcall(ContextActionService.UnbindAction, ContextActionService, "FlyCtrl")
end

local function startFly()
    if not ScriptSettings.FlyEnabled then return end
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    if flying then return end
    flying = true

    flyBodyVel          = Instance.new("BodyVelocity")
    flyBodyVel.MaxForce = Vector3.new(10000, 10000, 10000)
    flyBodyVel.Parent   = hrp

    local function handleFlyInput(_, inputState, input)
        local key   = input.KeyCode
        local state = (inputState == Enum.UserInputState.Begin)
        if     key == Enum.KeyCode.W            then flyKeys.W     = state
        elseif key == Enum.KeyCode.A            then flyKeys.A     = state
        elseif key == Enum.KeyCode.S            then flyKeys.S     = state
        elseif key == Enum.KeyCode.D            then flyKeys.D     = state
        elseif key == Enum.KeyCode.Space        then flyKeys.Space = state
        elseif key == Enum.KeyCode.LeftControl  then flyKeys.Ctrl  = state
        end
        return Enum.ContextActionResult.Pass
    end
    ContextActionService:BindAction("FlyW",     handleFlyInput, false, Enum.KeyCode.W)
    ContextActionService:BindAction("FlyA",     handleFlyInput, false, Enum.KeyCode.A)
    ContextActionService:BindAction("FlyS",     handleFlyInput, false, Enum.KeyCode.S)
    ContextActionService:BindAction("FlyD",     handleFlyInput, false, Enum.KeyCode.D)
    ContextActionService:BindAction("FlySpace", handleFlyInput, false, Enum.KeyCode.Space)
    ContextActionService:BindAction("FlyCtrl",  handleFlyInput, false, Enum.KeyCode.LeftControl)

    task.spawn(function()
        while flying and ScriptSettings.FlyEnabled do
            local moveDir = Vector3.new(0,0,0)
            if flyKeys.W     then moveDir = moveDir + Vector3.new(0,0,-1) end
            if flyKeys.S     then moveDir = moveDir + Vector3.new(0,0, 1) end
            if flyKeys.A     then moveDir = moveDir + Vector3.new(-1,0,0) end
            if flyKeys.D     then moveDir = moveDir + Vector3.new( 1,0,0) end
            if flyKeys.Space then moveDir = moveDir + Vector3.new(0, 1,0) end
            if flyKeys.Ctrl  then moveDir = moveDir + Vector3.new(0,-1,0) end
            if moveDir.Magnitude > 0 then
                moveDir = moveDir.Unit
                local cam    = workspace.CurrentCamera
                local camF   = cam.CFrame.LookVector
                local camR   = cam.CFrame.RightVector
                local worldMove = (camF * -moveDir.Z + camR * moveDir.X + Vector3.new(0, moveDir.Y, 0))
                if worldMove.Magnitude > 0 then worldMove = worldMove.Unit * ScriptSettings.FlySpeed end
                flyBodyVel.Velocity = worldMove
            else
                flyBodyVel.Velocity = Vector3.new(0,0,0)
            end
            task.wait()
        end
        if flyBodyVel then flyBodyVel:Destroy() end
        flying = false
    end)
end

local noclipConn = nil
local function setNoclip()
    if noclipConn then noclipConn:Disconnect() noclipConn = nil end
    if ScriptSettings.NoclipEnabled then
        noclipConn = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    end
end

local function applyPlayerSettings()
    setJumpPower()
    setSpeed()
    if ScriptSettings.FlyEnabled then
        if not flying then startFly() end
    else
        if flying then stopFly() end
    end
    setNoclip()
end

local function onCharacterAdded(char)
    task.wait(0.2)
    applyPlayerSettings()
end
if LocalPlayer.Character then task.spawn(onCharacterAdded, LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(onCharacterAdded)

