    if autoFarmToggle     then autoFarmToggle.setValue(ScriptSettings.AutoFarmEnabled, true) end
    if autoGunDropToggle  then autoGunDropToggle.setValue(ScriptSettings.AutoGunDropEnabled, true) end

    syncTracerColorButton()
end

local function loadConfig(name)
    local data = loadCfg(name)
    if type(data) ~= "table" then return false end

    if type(data.ESPEnabled)         == "boolean" then ScriptSettings.ESPEnabled         = data.ESPEnabled end
    if type(data.TracerEnabled)      == "boolean" then ScriptSettings.TracerEnabled      = data.TracerEnabled end
    if type(data.TracerColorR)       == "number" and type(data.TracerColorG) == "number" and type(data.TracerColorB) == "number" then
        ScriptSettings.TracerColor = Color3.new(data.TracerColorR, data.TracerColorG, data.TracerColorB)
    end
    if type(data.TracerLength)       == "number"  then ScriptSettings.TracerLength       = data.TracerLength end
    if type(data.TracerThickness)    == "number"  then ScriptSettings.TracerThickness    = data.TracerThickness end
    if type(data.JumpPowerEnabled)   == "boolean" then ScriptSettings.JumpPowerEnabled   = data.JumpPowerEnabled end
    if type(data.JumpPowerValue)     == "number"  then ScriptSettings.JumpPowerValue     = data.JumpPowerValue end
    if type(data.SpeedEnabled)       == "boolean" then ScriptSettings.SpeedEnabled       = data.SpeedEnabled end
    if type(data.SpeedValue)         == "number"  then ScriptSettings.SpeedValue         = data.SpeedValue end
    if type(data.FlyEnabled)         == "boolean" then ScriptSettings.FlyEnabled         = data.FlyEnabled end
    if type(data.FlySpeed)           == "number"  then ScriptSettings.FlySpeed           = data.FlySpeed end
    if type(data.NoclipEnabled)      == "boolean" then ScriptSettings.NoclipEnabled      = data.NoclipEnabled end
    if type(data.AutoFarmEnabled)    == "boolean" then ScriptSettings.AutoFarmEnabled    = data.AutoFarmEnabled end
    if type(data.FarmDelay)          == "number"  then ScriptSettings.FarmDelay          = data.FarmDelay end
    if type(data.AutoGunDropEnabled) == "boolean" then ScriptSettings.AutoGunDropEnabled = data.AutoGunDropEnabled end
    if type(data.GunDropDelay)       == "number"  then ScriptSettings.GunDropDelay       = data.GunDropDelay end

    applySettingsToUI()

    -- Re-apply runtime side-effects
    if not ScriptSettings.ESPEnabled then removeAllHighlights() end
    if not ScriptSettings.TracerEnabled then clearAllTracers() end
    onFarmToggle()
    onGunDropToggle()
    applyPlayerSettings()

    return true
end

