-- Полноценная система конфигов (как в предыдущих версиях)
local useFS = pcall(function() return isfolder and makefolder and listfiles and writefile and readfile and delfile end)
local globalCfgs = getgenv()._Fer4ixzMM2Configs or {}
getgenv()._Fer4ixzMM2Configs = globalCfgs

local function saveCfg(name, data)
    if useFS then
        local folder = "MM2Configs"
        if not isfolder(folder) then makefolder(folder) end
        return pcall(writefile, folder.."/"..name..".json", HttpService:JSONEncode(data))
    else
        globalCfgs[name] = data
        return true
    end
end

local function loadCfg(name)
    if useFS then
        local folder = "MM2Configs"
        local ok, cont = pcall(readfile, folder.."/"..name..".json")
        if ok and cont then return HttpService:JSONDecode(cont) end
        return nil
    else
        return globalCfgs[name]
    end
end

local function listCfgs()
    if useFS then
        local folder = "MM2Configs"
        if not isfolder(folder) then return {} end
        local files = listfiles(folder)
        local names = {}
        for _, f in ipairs(files) do
            local n = f:match("([^/\\]+)%.json$")
            if n then table.insert(names, n) end
        end
        return names
    else
        local names = {}
        for n in pairs(globalCfgs) do table.insert(names, n) end
        return names
    end
end

local function delCfg(name)
    if useFS then
        local folder = "MM2Configs"
        return pcall(delfile, folder.."/"..name..".json")
    else
        globalCfgs[name] = nil
        return true
    end
end

local function getAuto()
    if useFS then
        local folder = "MM2Configs"
        if isfolder(folder) and isfile(folder.."/autoload.txt") then
            local n = readfile(folder.."/autoload.txt"):gsub("\n","")
            if n ~= "" then
                for _, c in ipairs(listCfgs()) do if c == n then return n end end
            end
        end
        return nil
    else
        return getgenv()._Fer4ixzMM2Autoload
    end
end

local function setAuto(name)
    if useFS then
        local folder = "MM2Configs"
        if not isfolder(folder) then makefolder(folder) end
        writefile(folder.."/autoload.txt", name)
    else
        getgenv()._Fer4ixzMM2Autoload = name
    end
end

local function delAuto()
    if useFS then
        local folder = "MM2Configs"
        if isfolder(folder) and isfile(folder.."/autoload.txt") then delfile(folder.."/autoload.txt") end
    else
        getgenv()._Fer4ixzMM2Autoload = nil
    end
end

local function createConfig(name)
    if name == nil or name == "" then return false end
    local data = {
        ESPEnabled = ScriptSettings.ESPEnabled,
        AutoFarmEnabled = ScriptSettings.AutoFarmEnabled,
        FarmDelay = ScriptSettings.FarmDelay,
        TracerEnabled = ScriptSettings.TracerEnabled,
        TracerColorR = ScriptSettings.TracerColor.R,
        TracerColorG = ScriptSettings.TracerColor.G,
        TracerColorB = ScriptSettings.TracerColor.B,
        TracerLength = ScriptSettings.TracerLength,
        TracerThickness = ScriptSettings.TracerThickness,
        JumpPowerEnabled = ScriptSettings.JumpPowerEnabled,
        JumpPowerValue = ScriptSettings.JumpPowerValue,
        SpeedEnabled = ScriptSettings.SpeedEnabled,
        SpeedValue = ScriptSettings.SpeedValue,
        FlyEnabled = ScriptSettings.FlyEnabled,
        NoclipEnabled = ScriptSettings.NoclipEnabled,
        AutoGunDropEnabled = ScriptSettings.AutoGunDropEnabled,
        GunDropDelay = ScriptSettings.GunDropDelay,
    }
    return saveCfg(name, data)
end

local function loadConfig(name)
    local data = loadCfg(name)
    if data then
        ScriptSettings.ESPEnabled = data.ESPEnabled
        ScriptSettings.AutoFarmEnabled = data.AutoFarmEnabled
        ScriptSettings.FarmDelay = data.FarmDelay
        ScriptSettings.TracerEnabled = data.TracerEnabled
        ScriptSettings.TracerColor = Color3.fromRGB(data.TracerColorR or 255, data.TracerColorG or 100, data.TracerColorB or 0)
        ScriptSettings.TracerLength = data.TracerLength or 15
        ScriptSettings.TracerThickness = data.TracerThickness or 0.3
        ScriptSettings.JumpPowerEnabled = data.JumpPowerEnabled
        ScriptSettings.JumpPowerValue = data.JumpPowerValue or 50
        ScriptSettings.SpeedEnabled = data.SpeedEnabled
        ScriptSettings.SpeedValue = data.SpeedValue or 32
        ScriptSettings.FlyEnabled = data.FlyEnabled
        ScriptSettings.NoclipEnabled = data.NoclipEnabled
        ScriptSettings.AutoGunDropEnabled = data.AutoGunDropEnabled
        ScriptSettings.GunDropDelay = data.GunDropDelay or 2

        if toggleRegistry["Enable ESP"] then toggleRegistry["Enable ESP"](ScriptSettings.ESPEnabled) end
        if toggleRegistry["AutoFarm (coins)"] then toggleRegistry["AutoFarm (coins)"](ScriptSettings.AutoFarmEnabled) end
        if toggleRegistry["Enable Tracer"] then toggleRegistry["Enable Tracer"](ScriptSettings.TracerEnabled) end
        if toggleRegistry["Jump Power"] then toggleRegistry["Jump Power"](ScriptSettings.JumpPowerEnabled) end
        if toggleRegistry["Speed Hack"] then toggleRegistry["Speed Hack"](ScriptSettings.SpeedEnabled) end
        if toggleRegistry["Fly (WASD + Space/Ctrl)"] then toggleRegistry["Fly (WASD + Space/Ctrl)"](ScriptSettings.FlyEnabled) end
        if toggleRegistry["NoClip (walk through walls)"] then toggleRegistry["NoClip (walk through walls)"](ScriptSettings.NoclipEnabled) end
        if toggleRegistry["Auto TP to GunDrop"] then toggleRegistry["Auto TP to GunDrop"](ScriptSettings.AutoGunDropEnabled) end

        delayStepper.setValue(ScriptSettings.FarmDelay)
        lengthStepper.setValue(ScriptSettings.TracerLength)
        thickStepper.setValue(ScriptSettings.TracerThickness)
        jumpStepper.setValue(ScriptSettings.JumpPowerValue)
        speedStepper.setValue(ScriptSettings.SpeedValue)
        delayGunStepper.setValue(ScriptSettings.GunDropDelay)

        for i, col in ipairs(tracerColors) do
            if col[1] == ScriptSettings.TracerColor then
                tracerColorIdx = i
                tracerColorBtn.Text = "Color: " .. col[2]
                break
            end
        end

        onFarmToggle()
        onGunDropToggle()
        applyPlayerSettings()
        return true
    end
    return false
end

