-- =====================================================================
-- ESP / TRACER CORE
-- =====================================================================
local roles      = {}
local Murder     = nil
local Sheriff    = nil
local Hero       = nil
local tracers    = {}

local function isAlive(playerName)
    for name, data in pairs(roles) do
        if name == playerName then
            return not data.Killed and not data.Dead
        end
    end
    return false
end

local function createHighlight(player)
    if player == LocalPlayer then return nil end
    local char = player.Character
    if char and not char:FindFirstChild("MM2Highlight") then
        local hl = Instance.new("Highlight")
        hl.Name             = "MM2Highlight"
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.Parent           = char
        return hl
    end
    return nil
end

local function removeAllHighlights()
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then
            local hl = player.Character:FindFirstChild("MM2Highlight")
            if hl then hl:Destroy() end
        end
    end
end

local function updateHighlightColors()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local hl = player.Character:FindFirstChild("MM2Highlight")
            if hl then
                if player.Name == Sheriff and isAlive(Sheriff) then
                    hl.FillColor = Color3.fromRGB(0, 0, 225)
                elseif player.Name == Murder and isAlive(Murder) then
                    hl.FillColor = Color3.fromRGB(225, 0, 0)
                elseif player.Name == Hero and isAlive(Hero) and (not Sheriff or not isAlive(Sheriff)) then
                    hl.FillColor = Color3.fromRGB(255, 250, 0)
                else
                    hl.FillColor = Color3.fromRGB(0, 225, 0)
                end
            end
        end
    end
end

-- Throttle role fetches: InvokeServer is synchronous, calling it per frame
-- (as the original deobfuscated script does) tanks performance.
local lastRoleFetch = 0
local function fetchRoles()
    local now = tick()
    if now - lastRoleFetch < 1 then return end
    lastRoleFetch = now

    local getDataRemote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if not getDataRemote then return end
    local success, data = pcall(function() return getDataRemote:InvokeServer() end)
    if success and type(data) == "table" then
        roles   = data
        Murder, Sheriff, Hero = nil, nil, nil
        for name, info in pairs(roles) do
            if info.Role == "Murderer" then Murder = name
            elseif info.Role == "Sheriff" then Sheriff = name
            elseif info.Role == "Hero" then Hero = name
            end
        end
    end
end

local function clearAllTracers()
    for p, line in pairs(tracers) do
        if line then line:Destroy() end
        tracers[p] = nil
    end
end

local function updateTracers()
    if not ScriptSettings.TracerEnabled then
        if next(tracers) ~= nil then clearAllTracers() end
        return
    end
    for _, p in pairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local char = p.Character
        if not char then
            if tracers[p] then tracers[p]:Destroy() tracers[p] = nil end
            continue
        end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        local dir = hrp.CFrame.LookVector
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude < 0.001 then continue end
        dir = dir.Unit
        local startPos = hrp.Position
        local length   = ScriptSettings.TracerLength
        local endPos   = startPos + dir * length
        endPos         = Vector3.new(endPos.X, startPos.Y, endPos.Z)
        local distance = (endPos - startPos).Magnitude
        if not tracers[p] then
            local line = Instance.new("Part")
            line.Anchored    = true
            line.CanCollide  = false
            line.Material    = Enum.Material.Neon
            line.Size        = Vector3.new(ScriptSettings.TracerThickness, ScriptSettings.TracerThickness, distance)
            local mesh = Instance.new("BlockMesh")
            mesh.Parent = line
            line.Parent = workspace
            tracers[p]  = line
        end
        local line = tracers[p]
        if distance < 0.5 then
            line.Transparency = 1
            continue
        end
        line.Transparency = 0
        line.Color        = ScriptSettings.TracerColor
        line.Size         = Vector3.new(ScriptSettings.TracerThickness, ScriptSettings.TracerThickness, distance)
        local mid = (startPos + endPos) / 2
        line.CFrame = CFrame.lookAt(mid, endPos)
    end
    for p, line in pairs(tracers) do
        if not p or not p.Character then
            line:Destroy()
            tracers[p] = nil
        end
    end
end

RunService.RenderStepped:Connect(function()
    fetchRoles()
    if ScriptSettings.ESPEnabled then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and not player.Character:FindFirstChild("MM2Highlight") then
                createHighlight(player)
            end
        end
        updateHighlightColors()
    end
    updateTracers()
end)

